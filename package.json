{
  "name": "edu-network",
  "version": "0.1.0",
  "type": "module",
  "description": "Навчальний тренажер «Мережева лабораторія»: ПК, світчі й роутери, IP-адреси та ping у браузері. Форк netsim (Michael Borck, MIT)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.0",
    "fflate": "^0.8.3",
    "lz-string": "^1.5.0",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavada123/edu-network.git"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core": {
      "types": "./lib/types/core.d.ts",
      "import": "./lib/core.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/react.js"
    },
    "./style.css": "./lib/style.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
